<% if @problem.persisted? %>
  <% set_page_title "Edit " + @problem.id.to_s + " - " + @problem.name %>
<% else %>
  <% set_page_title "New problem" %>
<% end %>

<%= nested_form_for @problem, html: {class: 'form', id: 'problem-form'} do |f| %>
  <%= render partial: "shared/errors", locals: {errors: @problem.errors, item: 'problem'} %>


<div class="card with-nav-tabs panel-problem-settings">
  <div class="card-header">
    <ul class="nav nav-tabs">
      <li class="nav-item">
        <a class="nav-link active" href="#general-settings-tab" data-bs-toggle="tab">General Settings</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="#judge-settings-tab" data-bs-toggle="tab">Judge Settings</a>
      </li>
    </ul>
  </div>

  <div class="card-body">
    <div class="tab-content">
      <div class="tab-pane fade show active" id="general-settings-tab">

        <div class="mb-3">
          <%= f.label :name %>
          <%= f.text_field :name, class: 'form-control' %>
        </div>

        <div class="row">
          <div class="col-md-4 mb-3">
            <div>
              <%= f.label :tag_list, "Tags" %>
              <%= f.text_field :tag_list, value: @problem.tag_list.to_s, class: 'form-control' %>
            </div>
          </div>
          <div class="col-md-4 mb-3">
            <div>
              <%= f.label :solution_tag_list, "Solution Tags" %>
              <%= f.text_field :solution_tag_list, value: @problem.solution_tag_list.to_s, class: 'form-control' %>
            </div>
          </div>
          <script>
            const tomselect_config = {
              plugins: {
                remove_button:{
                  title: 'Remove this item',
                }
              },
              persist: false,
              create: true,
              onDelete: function(values) {
                return confirm(values.length > 1 ? 'Are you sure you want to remove these ' + values.length + ' items?' : 'Are you sure you want to remove "' + values[0] + '"?');
              }
            };
            new TomSelect("#<%= f.field_id :tag_list %>", tomselect_config);
            new TomSelect("#<%= f.field_id :solution_tag_list %>", tomselect_config);
          </script>

          <div class="col-md-4 mb-3">
            <%= f.label :visible_state %>
            <%= f.select :visible_state, Problem.visible_states.keys.map.with_index {|x, index| ["[#{index}] #{visible_state_desc_map[x].capitalize}", x]},
              {}, {class: 'form-select'} %>
          </div>
        </div>

        <div class="mb-3">
          <%= f.label :description %>
          <%= f.text_area :description, class: 'form-control', rows: '9' %>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <%= f.label :input, "Input Format" %>
            <%= f.text_area :input, class: 'form-control', rows: '7' %>
          </div>
          <div class="col-md-6 mb-3">
            <%= f.label :output, "Output Format" %>
            <%= f.text_area :output, class: 'form-control', rows: '7' %>
          </div>
        </div>

        <%= f.fields_for :sample_testdata do |t| %>
          <div class="row">
            <div class="col-md-6 mb-3">
              <%= t.label :input, "Sample Input", class: "sample_input" %>
              <%= t.text_area :input, class: 'form-control code-input', rows: '7' %>
            </div>
            <div class="col-md-6 mb-3">
              <%= t.label :output, "Sample Output", class: "sample_output" %>
              <%= t.text_area :output, class: 'form-control code-input', rows: '7' %>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <%= t.label :display_type, "Sample Display Type" %>
              <%= t.select :display_type, SampleTestdatum.display_types.keys.map{|key| [sample_display_type_desc_map[key], key]}, {}, {class: 'form-select'} %>
            </div>
            <div class="col-md-6 mb-3">
              <label></label><br>
              <%= t.link_to_remove "Remove this sample testdatum", class: "btn btn-danger", name: "testdatum_remove" %>
            </div>
          </div>
        <% end %>

        <div class="row">
          <div class="col-md-6 mb-3"></div>
          <div class="col-md-6 mb-3">
            <%= f.link_to_add "Add sample testdatum", :sample_testdata, class: "btn btn-warning", id: "testdatum_add" %>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <%= f.label :hint, "Hints" %>
            <%= f.text_area :hint, class: 'form-control', rows: '3' %>
          </div>
          <div class="col-md-6 mb-3">
            <%= f.label :source, "Problem Source" %>
            <%= f.text_area :source, class: 'form-control', rows: '3' %>
          </div>
        </div>

        <div>
          <%= f.label :discussion_visibility %>
          <%= f.select :discussion_visibility, Problem.discussion_visibilities.keys.map.with_index {|x, index| ["[#{index}] #{discussion_visibility_desc_map[x]}", x]},
            {}, {class: 'form-control'} %>
        </div>
      </div>

      <div class="tab-pane fade" id="judge-settings-tab">

        <div class="mb-3">
          <%= f.label :compilers, "Banned compilers" %>
          <div class="d-flex flex-wrap gap-1">
            <% Compiler.order(order: :asc).all.each do |c| %>
              <span class="button-checkbox">
                <%= button_tag c.name, type: "button", class: "btn", "data-color": "danger" %>
                <%= check_box_tag "problem[compiler_ids][]", c.id, @ban_compiler_ids.include?(c.id), hidden: true %>
              </span>
            <% end %>
          </div>
        </div>

        <div class="row">
          <div class="col-md-4 mb-3">
            <%= f.label :specjudge_type, raw('Special Judge Mode ') + help_icon('https://github.com/TIOJ-INFOR-Online-Judge/tioj/wiki/Problems#special-judge-modes', true) %>
            <%= f.select :specjudge_type, Problem.specjudge_types.keys.map.with_index {|x, index| ["[#{index}] #{specjudge_type_desc_map[x]}", x]},
              {}, {class: 'form-control'} %>
          </div>
          <div class="col-md-4 mb-3">
            <%= f.label :interlib_type, "Interactive Library Type" %>
            <%= f.select :interlib_type, Problem.interlib_types.keys.map.with_index {|x, index| ["[#{index}] #{interlib_type_desc_map[x]}", x]},
              {}, {class: 'form-control'} %>
          </div>
          <div class="col-md-4 mb-3">
            <%= f.label :num_stages, help_collapse_toggle('Number of execution stages', 'stagesDescription') %>
            <div class="collapse" id="stagesDescription">
              <div class="card bg-white mb-3">
                <div class="card-body small" style="line-height: 1.4;">
                  The user's program will be run this number of times. If greater than 1, the 0-based stage number will be given via <code>argv[1]</code>.<br>
                  Each stage's output will be the input of the next stage; The last stage's output is the final answer.<br>
                  Special judge can be configured to run between stages for more checking. See <a href="https://github.com/TIOJ-INFOR-Online-Judge/tioj/wiki/Problems#multi-stage-problems" target="_blank">TIOJ wiki</a> for more details about multi-stage problems.
                </div>
              </div>
            </div>
            <%= f.number_field :num_stages, in: 1..10, class: 'form-control', required: true %>
          </div>
        </div>

        <div class="mb-3">
          <%= f.check_box :_problem_prog_enabled, class: 'form-check-input', checked: !@problem.problem_prog_stage_list.empty? %>
          <%= f.label :_problem_prog_enabled, help_collapse_toggle('Enable Problem Program', 'problemProgDescription') %>
        </div>
        <div class="collapse" id="problemProgDescription" style="height: auto;">
            <div class="card bg-white mb-3">
              <div class="card-body small">
              Add a problem program so that at some specific stages, the problem program will be executed instead of the user's program. This can be used to build hacking problems.<br>
              Note that when setting up a hacking problem, the special judge must configure the <code>time_us</code> output to (problem TL - intended TL of the program being hacked) before the stage (see the description of special judge for details about overriding <code>time_us</code>). Otherwise, the user can just run the program to near the TL to cause TLE on the program to be hacked, because the time limit is by default shared by all stages.
            </div>
          </div>
        </div>

        <div class="row visibility-problem-prog visibility-problem-prog-1">
          <div class="col-lg-6">
            <div class="mb-3">
              <%= f.label :problem_prog_compiler_id, "Problem Program Compiler" %>
              <%= f.select :problem_prog_compiler_id, options_for_select(@compiler.map{|x| [x.description, x.id]}, @problem.problem_prog_compiler_id || @compiler[0].id),
                {}, {class: 'form-control'} %>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="mb-3">
              <%= f.label :problem_prog_stage_list do %>
                Problem Program Stage List (0-based stage number, e.g.: <code>0</code>, <code>1,3</code>, <code>0,2-4</code>)
              <% end %>
              <%= f.text_field :problem_prog_stage_list, class: 'form-control' %>
            </div>
          </div>
        </div>
        <div class="mb-3 visibility-problem-prog visibility-problem-prog-1">
          <%= f.label :problem_prog_code, "Problem Program Code" %>
          <%= f.text_area :problem_prog_code, class: 'form-control code-input', rows: '7' %>
        </div>
        <hr class="visibility-problem-prog visibility-problem-prog-1" style="border-top: 2px solid #ddd">

        <div class="mb-3 visibility-specjudge visibility-specjudge-old visibility-specjudge-new visibility-specjudge-polygon visibility-specjudge-kattis">
          <%= f.label :specjudge_compiler_id, "Special Judge Compiler" %>
          <%= f.select :specjudge_compiler_id, options_for_select(@compiler.map{|x| [x.description, x.id]}, @problem.specjudge_compiler_id || @compiler[0].id),
            {}, {class: 'form-control'} %>
        </div>
        <div class="mb-3 visibility-specjudge visibility-specjudge-old visibility-specjudge-new visibility-specjudge-polygon visibility-specjudge-kattis">
          <%= f.label :specjudge_compile_args, 'Additional compilation arguments of special judge program' %>
          <%= f.text_field :specjudge_compile_args, class: 'form-control' %>
        </div>
        <div class="mb-3 visibility-specjudge visibility-specjudge-old visibility-specjudge-new visibility-specjudge-polygon visibility-specjudge-kattis">
          <%= f.label :sjcode, raw('Special Judge Code ') + help_icon('https://github.com/TIOJ-INFOR-Online-Judge/tioj/wiki/Problems#special-judge-modes', true) %>
          <%= f.text_area :sjcode, class: 'form-control code-input', rows: '7' %>
        </div>
        <div class="visibility-specjudge visibility-specjudge-old visibility-specjudge-new visibility-specjudge-polygon visibility-specjudge-kattis">
          <div class="d-flex flex-column gap-2 mb-3">
            <div>
              <%= f.check_box :judge_between_stages, class: 'form-check-input' %>
              <%= f.label :judge_between_stages, class: 'form-check-label' do %>
                Invoke special judge between stages (only applicable if number of stages &gt; 1)
              <% end %>
            </div>

            <div>
              <%= f.check_box :judge_abnormally_terminated, class: 'form-check-input' %>
              <%= f.label :judge_abnormally_terminated, class: 'form-check-label' do %>
                Invoke special judge even if the user program didn't terminate normally (e.g. <span class="text-tle">TLE</span>, <span class="text-sig">SIG</span>)
              <% end %>
            </div>
            <div>
              <%= f.check_box :judge_re_as_wa, class: 'form-check-input' %>
              <%= f.label :judge_re_as_wa, class: 'form-check-label' do %>
                Treat special judge abnormally terminating as <span class="text-wa">WA</span> (instead of JRE)
              <% end %>
            </div>
          </div>
        </div>

        <div class="mb-3 visibility-specjudge visibility-specjudge-none">
          <%= f.label :default_scoring_args, help_collapse_toggle('Arguments of default scoring program', 'scoringArgsDescription') %>
          <div class="collapse" id="scoringArgsDescription" style="height: auto;">
            <div class="card bg-white mb-3">
              <div class="card-body small">
                Pass arguments to the default scoring program for different comparison behavior. Possible arguments:<br>
                <ul style="line-height: 1.4;">
                  <li><code>line</code> (or simply left blank): Compare two files line-by-line. Two lines are considered matched if they are the same after removing all trailing whitespaces. Trailing lines containing only whitespaces are ignored. This is the behavior of old TIOJ.<br></li>
                  <li><code>strict</code>: Byte-wise comparison.<br></li>
                  <li><code>white-diff</code>: Compare two files line-by-line. Two lines are considered matched if the list of non-empty, whitespace-separated "words" is the same. Trailing lines containing only whitespaces are ignored. This is the behavior of CMS white-diff comparator.<br></li>
                  <li><code>float-diff [absolute/relative/absolute-relative] [threshold]</code>: Similar to <code>white-diff</code>, but two words are also considered matched if the answer is a floating-point number (specifically, parsable by <code>std::stold</code> and contains at least one of the following characters: <code>.eExXnN</code>), and the absolute and/or relative error of the user's output is less than or equal to the given threshold.<br></li>
                  <li><code>verbose</code>: Send a message indicating the incorrect output position to the user. Can be prepended to the above options.</li>
                </ul>
              </div>
            </div>
          </div>
          <%= f.text_field :default_scoring_args, class: 'form-control' %>
        </div>

        <hr class="visibility-specjudge visibility-specjudge-old visibility-specjudge-new visibility-specjudge-polygon visibility-specjudge-kattis" style="border-top: 2px solid #ddd">

        <div class="mb-3 visibility-interlib visibility-interlib-header">
          <div class="col">
            <%= f.label :interlib, raw('Interactive Library Header ( <code>#include "lib' + @problem.id.to_s.rjust(4, '0') + '.h"</code> )') %>
            <%= f.text_area :interlib, class: 'form-control code-input', rows: '7' %>
          </div>
        </div>
        <div class="mb-3 visibility-interlib visibility-interlib-header">
          <%= f.label :interlib_impl, raw("Interactive Library Implementation (will be linked with user's program)") %>
          <%= f.text_area :interlib_impl, class: 'form-control code-input', rows: '7' %>
        </div>

        <hr class="visibility-interlib visibility-interlib-header" style="border-top: 2px solid #ddd">

        <div class="mb-3">
          <%= f.label :code_length_limit, 'Code length limit (bytes)' %>
          <%= f.number_field :code_length_limit, in: 1..16777216, class: 'form-control', required: true %>
        </div>

        <div class="d-flex flex-column gap-2 mb-3">
          <div>
            <%= f.check_box :ranklist_display_score, class: 'form-check-input' %>
            <%= f.label :ranklist_display_score, class: 'form-check-label' do %>
              Display score in ranklist
            <% end %>
          </div>
          <div>
            <%= f.check_box :skip_group, class: 'form-check-input' %>
            <%= f.label :skip_group, class: 'form-check-label' do %>
              Skip the remaining testdata in the task if any of the testdata got non-AC
            <% end %>
          </div>
          <div>
            <%= f.check_box :strict_mode, class: 'form-check-input' %>
            <%= f.label :strict_mode, help_collapse_toggle("Use strict mode", "strictModeDescription") %>
          </div>
          <div class="collapse" id="strictModeDescription" style="height: auto;">
            <div class="card bg-white mb-3">
              <div class="card-body small">
                Strict mode provides more isolation measures when running user's program, including:
                <ul style="line-height: 1.4;">
                  <li>(C/C++/Haskell/Rust only) Compile to static executable and run it without any shared libraries present (to avoid calling shared libraries that are not meant to be used; also reduces base memory usage)</li>
                  <li>Use pipes instead of regular files for stdin/stdout (to avoid re-opening or seeking)</li>
                  <li>Block the program from creating any files</li>
                </ul>
              </div>
            </div>
          </div>

        </div>


        <div class="mb-3">
          <%= f.label :summary_type, "Summary Type" %>
          <%= f.select :summary_type, Problem.summary_types.keys.map.with_index {|x, index| ["[#{index}] #{summary_type_desc_map[x]}", x]},
            {}, {class: 'form-control'} %>
        </div>

        <div class="mb-3 visibility-summary visibility-summary-none">
          <%= f.label :score_precision, "Score Precision" %>
          <%= f.number_field :score_precision, in: 0..6, class: 'form-control', required: true %>
        </div>

        <div class="mb-3 visibility-summary visibility-summary-custom">
          <%= f.label :summary_compiler_id, "Summary Compiler" %>
          <%= f.select :summary_compiler_id, options_for_select(@compiler.map{|x| [x.description, x.id]}, @problem.summary_compiler_id || @compiler[0].id),
            {}, {class: 'form-control'} %>
        </div>
        <div class="mb-3 visibility-summary visibility-summary-custom">
          <%= f.label :summary_code, help_collapse_toggle('Summary Code', 'summaryDescription') %>
          <div class="collapse" id="summaryDescription">
            <div class="card bg-white mb-3">
              <div class="card-body small">
                The program is used to calculate the total score / time / memory, and potentially custom CE messages.<br>
                It will be provided a metadata file; the path is in <code>argv[1]</code>. It is a JSON file with the following fields:
                <pre class="overflow-auto p-2 border" style="max-height: 200px; line-height: 1.2;"><%= JSON.pretty_generate({
                  user_code_file: 'path_to_user_source_code',
                  problem_id: 1234,
                  submission_id: 123456,
                  contest_id: -1,
                  submitter_id: 123,
                  submitter_name: 'username',
                  submitter_nickname: 'nickname',
                  submission_time: 1656430000000000,
                  compiler: 'c++14/python2/etc.',
                  ce_message: 'CE message to be shown on user\'s submission page',
                  ce_message_file: 'path_to_full_ce_message',
                  verdict: 'AC',
                  testdata: [{
                    verdict: 'AC',
                    score: '100.000000',
                    time_us: 123456,
                    vss_kib: 66888,
                    rss_kib: 44888,
                    message_type: 'text',
                    message: 'meow',
                    ignore_verdict: false,
                    subtasks: [0, 1, 2, 3],
                  }],
                  subtask_scores: ["10.000000", "20.000000", "30.000000", "40.000000"],
                }) %></pre>
                The program must output a JSON object to stdout with the following fields (all fields are optional; default calculation is used if omitted):
                <pre class="p-2 border" style="line-height: 1.2;"><%= JSON.pretty_generate({
                  verdict: 'AC',
                  score: '1.35',
                  total_time_us: 123456,
                  total_memory_kib: 66888,
                  ce_message: 'Overriden CE message',
                }) %></pre>
                Notes:
                <ul style="line-height: 1.4;">
                  <li><code>contest_id</code> will be -1 if it is not a contest submission.</li>
                  <li><code>submission_time</code> is the created time of the submission, given by microseconds after UNIX epoch.</li>
                  <li><code>verdict</code> of a testdata will be an empty string if the execution is skipped (e.g. CE or "skip remaining testdata" option).</li>
                  <li><code>score</code> can be given by float or string.</li>
                  <li><code>ce_message</code> can be specified even if the verdict is not CE.</li>
                </ul>
                <code>#include "nlohmann/json.hpp"</code> (<a href="https://github.com/nlohmann/json/tree/v3.10.5">docs</a>) are provided for C++ special judge programs.
              </div>
            </div>
          </div>
          <%= f.text_area :summary_code, class: 'form-control code-input', rows: '7' %>
        </div>

        <div class="mb-3">
          <label>
            Testdata Sets (0-based testdata number, examples: <code>0</code>, <code>1-4</code>, <code>2,4,9-11,13-18</code>)
          </label>
        </div>

        <%= f.fields_for :subtasks do |t| %>
          <div class="row mb-3 align-items-center">
            <div class="col-lg-2">
              <%= t.label :td_list, "Testdata list:" %>
            </div>
            <div class="col-lg-2">
              <%= t.text_field :td_list, pattern: '\d+(-\d+)?(,\d+(-\d+)?)*', class: 'form-control', required: true %>
            </div>
            <div class="col-lg-1">
              <%= t.label :td_list, "Constraints:" %>
            </div>
            <div class="col-lg-3">
              <%= t.text_field :constraints, class: 'form-control' %>
            </div>
            <div class="col-lg-1">
              <%= t.label :score, "Score:" %>
            </div>
            <div class="col-lg-1">
              <%= t.number_field :score, in: 0..100000, step: :any, class: 'form-control', required: true %>
            </div>
            <div class="col-lg-1 mt-2">
              <%= t.link_to_remove "Remove", class: 'btn btn-danger' %>
            </div>
          </div>
        <% end %>
        <div class="mb-3">
          <%= f.link_to_add "Add a range", :subtasks, class: 'btn btn-warning' %>
        </div>

        <div class="mb-3">
          <%= f.label :verdict_ignore_td_list, "Testdata list to ignore in overall verdict calculation (needs rejudge)" %>
          <%= f.text_field :verdict_ignore_td_list, class: 'form-control' %>
        </div>

      </div>
    </div>
  </div>
</div>

<hr>
<div>
  <span class="flex-container-bottom-align">
    <%= f.submit class: 'btn btn-success btn-lg', id: 'submit-btn' %>
  </span>
</div>
<% end %>

<style>
.flex-container-bottom-align {
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  align-items: flex-end;
}
</style>

<script>
  initProblemForm();
</script>
